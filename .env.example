# Example environment variables for local development
# Copy to .env and fill values before running `npm install` and `npm run dev`

# Server
PORT=5000
SESSION_SECRET=your_session_secret_here
NODE_ENV=development

# Database (Postgres)
# Example: postgresql://user:password@localhost:5432/acrespay
DATABASE_URL=postgresql://user:password@localhost:5432/acrespay

# Replit / OIDC (only needed if using Replit Auth)
REPL_ID=
ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Local auth development (optional)
DEV_USER_ID=dev-user
DEV_USER_EMAIL=dev@example.com
DEV_USER_FIRST_NAME=Dev
DEV_USER_LAST_NAME=User
DEV_USER_AVATAR=
 
# Base URL for callbacks (used by Google callback default)
# For local dev: http://localhost:5000
# For Vercel: https://acrespay.vercel.app
APP_BASE_URL=http://localhost:5000


# Optional: set NODE_ENV=development when running dev script (package.json dev does this for you)
